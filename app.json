{
  "expo": {
    "name": "Reservas Deportivas",
    "slug": "reservas-deportivas-villaguay",
    "scheme": "reservasdeportivas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "ar.gob.villaguay.reservasdeportivas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "ar.gob.villaguay.reservasdeportivas",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E7D32"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para escanear el QR de ingreso de las reservas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para subir el estado de una cancha."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicacion para mostrarte el complejo deportivo mas cercano en el mapa."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para que vuelvas a entrar a tu cuenta sin escribir la contraseña."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
