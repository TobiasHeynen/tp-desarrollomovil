{
  "expo": {
    "name": "Reservas Deportivas",
    "slug": "reservas-deportivas-villaguay",
    "scheme": "reservasdeportivas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "android": {
      "package": "ar.gob.villaguay.reservasdeportivas",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "ar.gob.villaguay.reservasdeportivas",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para escanear el QR de ingreso de las reservas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicacion para mostrarte el complejo deportivo mas cercano en el mapa."
        }
      ],
      "expo-sqlite"
    ]
  }
}
